{
    "name": "markocupic/contao-sidebar-navigation",
    "description": "Sidebar navigation for Contao CMS",
    "keywords": [
        "contao",
        "sidebar",
        "navigation",
        "dropdown",
        "mobile",
        "vanilla"
    ],
    "type": "contao-bundle",
    "license": "GPL-3.0-or-later",
    "authors": [
        {
            "name": "Marko Cupic",
            "email": "m.cupic@gmx.ch",
            "homepage": "https://github.com/markocupic/contao-sidebar-navigation",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/markocupic/contao-sidebar-navigation/issues",
        "source": "https://github.com/markocupic/contao-sidebar-navigation"
    },
    "require": {
        "php": "^8.1",
        "contao/core-bundle": "^5.3 || ^6.0",
        "symfony/config": "^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.12",
        "contao/test-case": "^5.3 || ^6.0"
    },
    "conflict": {
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "autoload": {
        "psr-4": {
            "Markocupic\\ContaoSidebarNavigation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Markocupic\\ContaoSidebarNavigation\\Tests\\": "tests/"
        }
    },
    "extra": {
        "contao-manager-plugin": "Markocupic\\ContaoSidebarNavigation\\ContaoManager\\Plugin"
    },
    "config": {
        "allow-plugins": {
            "contao-components/installer": false,
            "contao/manager-plugin": false,
            "php-http/discovery": false,
            "contao-community-alliance/composer-plugin": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "scripts": {
        "cs-fixer": "@php tools/ecs/vendor/bin/ecs check --config tools/ecs/config/default.php --fix --ansi",
        "cs-check": "@php tools/ecs/vendor/bin/ecs check --config tools/ecs/config/default.php --ansi",
        "phpstan": "@php tools/phpstan/vendor/bin/phpstan analyse src tests",
        "unit-tests": "@php vendor/bin/phpunit --colors=always"
    }
}
